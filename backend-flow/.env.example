DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require&connection_limit=20&pool_timeout=15"

# Set to "true" once ALL schools have updated their Daraja C2B URLs
# to the tokenised endpoints. This disables the legacy open C2B routes.
DISABLE_LEGACY_C2B=false

# Shared secret sent by your SMS provider in the X-SMS-Webhook-Secret header
# Must match what you configure in your SMS provider's webhook settings
SMS_WEBHOOK_SECRET=your_secret_here
