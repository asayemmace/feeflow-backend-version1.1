# Required in production. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_string_here

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require&connection_limit=20&pool_timeout=15"

# Server timezone for date formatting and local business-day calculations
TZ=Africa/Nairobi

# Shared secret for Africa's Talking SMS delivery webhook
# Set this in AT dashboard: Settings -> SMS -> Delivery Reports -> Webhook Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMS_WEBHOOK_SECRET=your_secret_here
